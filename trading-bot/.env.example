# ============================================================
#  Copie ce fichier en ".env" puis remplis-le.
#  NE PARTAGE JAMAIS ton .env (il contient tes clés API).
# ============================================================

# --- Mode -------------------------------------------------------
# paper = simulation avec les vrais prix, AUCUN ordre réel (par défaut)
# live  = ordres réels sur ton compte
MODE=paper

# --- Plateforme (toute plateforme supportée par CCXT) -----------
# ex : kraken, binance, coinbase, bitstamp, bybit, okx...
EXCHANGE=kraken
API_KEY=
API_SECRET=
# Certaines plateformes (okx, kucoin, bitget) exigent une passphrase
API_PASSWORD=
# true = utiliser le testnet / sandbox de la plateforme si dispo
SANDBOX=false

# --- Marché -----------------------------------------------------
# Cryptos tradées, séparées par des virgules (même devise : EUR)
SYMBOLS=BTC/EUR,ETH/EUR
TIMEFRAME=4h

# --- Stratégie : suivi de tendance ------------------------------
# Investi quand EMA_FAST > EMA_SLOW, sorti sinon.
# 72/156 bougies de 4h = 12/26 jours.
EMA_FAST=72
EMA_SLOW=156

# --- Risque -----------------------------------------------------
# % du capital total investi quand TOUTES les cryptos sont en tendance haussière.
# Réparti à parts égales : avec 2 cryptos et 50 %, chacune reçoit 25 % du capital.
POSITION_PCT=50
# capital fictif de départ en mode paper
PAPER_START_BALANCE=1000
