# ============================================================
#  Copie ce fichier en ".env" puis remplis-le.
#  NE PARTAGE JAMAIS ton .env (il contient tes clés API).
# ============================================================

# --- Mode -------------------------------------------------------
# paper = simulation avec les vrais prix, AUCUN ordre réel (par défaut)
# live  = ordres réels sur ton compte
MODE=paper

# --- Plateforme (toute plateforme supportée par CCXT) -----------
# ex : binance, kraken, bitget, bybit, coinbase, okx, kucoin...
EXCHANGE=binance
API_KEY=
API_SECRET=
# Certaines plateformes (okx, kucoin, bitget) exigent une passphrase
API_PASSWORD=
# true = utiliser le testnet / sandbox de la plateforme si dispo
SANDBOX=false

# --- Marché -----------------------------------------------------
SYMBOL=BTC/USDT
TIMEFRAME=1h

# --- Stratégie (croisement EMA + filtre RSI, stop ATR) ----------
EMA_FAST=12
EMA_SLOW=26
RSI_PERIOD=14
RSI_MAX_ENTRY=70
ATR_PERIOD=14
STOP_ATR_MULT=2.0
TAKE_PROFIT_ATR_MULT=3.0

# --- Gestion du risque ------------------------------------------
# % du capital risqué par trade (perte si le stop est touché)
RISK_PER_TRADE_PCT=1.0
# % maximum du capital engagé dans une position
MAX_POSITION_PCT=25
# le bot arrête d'ouvrir des trades si la perte du jour dépasse ce %
MAX_DAILY_LOSS_PCT=3.0
# capital fictif de départ en mode paper
PAPER_START_BALANCE=1000
